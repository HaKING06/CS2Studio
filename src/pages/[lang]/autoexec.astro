---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AutoexecWidget from '../../components/AutoexecWidget.astro';
import { getDictionary, getStaticLangPaths, translateKey } from '../../utils/i18n.js';

export const getStaticPaths = getStaticLangPaths;

const { lang } = Astro.params;
const dict = getDictionary(lang);
const t = (key: string) => translateKey(dict, key);
---

<BaseLayout lang={lang} pageKey="autoexec" isPrefixed={true} title={t('pages.autoexecTitle')} description={t('pages.autoexecDesc')}>
  <AutoexecWidget lang={lang} isPrefixed={true} />
</BaseLayout>
