---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ViewmodelWidget from '../../components/ViewmodelWidget.astro';
import { getDictionary, getStaticLangPaths, translateKey } from '../../utils/i18n.js';

export const getStaticPaths = getStaticLangPaths;

const { lang } = Astro.params;
const dict = getDictionary(lang);
const t = (key: string) => translateKey(dict, key);
---

<BaseLayout lang={lang} pageKey="viewmodel" isPrefixed={true} title={t('pages.viewmodelTitle')} description={t('pages.viewmodelDesc')}>
  <ViewmodelWidget lang={lang} />
</BaseLayout>
