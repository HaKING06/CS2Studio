---
import { getDictionary, translateKey } from '../utils/i18n.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const t = (key: string) => translateKey(dict, key);
---

<section id="viewmodel-section" class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <span class="text-xs font-mono uppercase tracking-wider text-amber-400">{t('arena.modelStatus')}</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mt-1">{t('viewmodel.title')}</h1>
      <p class="text-sm text-slate-400 mt-1">{t('viewmodel.subtitle')}</p>
    </div>

    <div class="flex items-center gap-2">
      <label for="vm-weapon-select" class="text-xs font-semibold text-slate-400 uppercase">{t('arena.weapon')}</label>
      <select
        id="vm-weapon-select"
        class="bg-slate-900 border border-slate-700 text-white text-xs sm:text-sm rounded-lg px-3 py-2 focus:border-amber-400 focus:outline-none"
      ></select>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
    <!-- Live 3D Viewmodel Viewport -->
    <div class="xl:col-span-7 space-y-3">
      <div
        id="vm-stage"
        class="relative w-full aspect-[16/9] min-h-[320px] rounded-2xl overflow-hidden border border-amber-500/25 shadow-[0_25px_70px_rgba(0,0,0,0.65)] bg-slate-950 select-none"
      >
        <canvas id="vm-webgl" class="w-full h-full block"></canvas>
        <canvas id="vm-crosshair" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>

        <div class="pointer-events-none absolute top-3 left-3">
          <span id="vm-model-label" class="px-2.5 py-1 rounded-md bg-slate-950/75 border border-slate-700/80 text-xs font-mono font-bold text-amber-300 backdrop-blur-sm">
            AK-47 • HD
          </span>
        </div>

        <div class="pointer-events-none absolute bottom-3 left-3">
          <span class="px-3 py-1 rounded-lg bg-slate-950/75 border border-slate-700/70 text-xs text-slate-300 backdrop-blur-sm">
            {t('viewmodel.bobHint')}
          </span>
        </div>
      </div>

      <p class="text-xs font-mono text-slate-400">{t('arena.dropGlbHint')}</p>
    </div>

    <!-- Sliders & Presets -->
    <div class="xl:col-span-5 cs2-glass rounded-2xl p-5 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="flex justify-between text-xs">
            <span class="text-slate-300 font-semibold">{t('viewmodel.fov')}</span>
            <span id="val-vm-fov" class="font-mono text-amber-300 font-bold">68</span>
          </div>
          <input id="vm-fov" type="range" min="54" max="68" step="1" class="w-full cs2-slider amber" />
        </div>

        <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="flex justify-between text-xs">
            <span class="text-slate-300 font-semibold">{t('viewmodel.offsetX')}</span>
            <span id="val-vm-x" class="font-mono text-amber-300 font-bold">2.5</span>
          </div>
          <input id="vm-offset-x" type="range" min="-2.5" max="2.5" step="0.1" class="w-full cs2-slider amber" />
        </div>

        <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="flex justify-between text-xs">
            <span class="text-slate-300 font-semibold">{t('viewmodel.offsetY')}</span>
            <span id="val-vm-y" class="font-mono text-amber-300 font-bold">0.0</span>
          </div>
          <input id="vm-offset-y" type="range" min="-2" max="2" step="0.1" class="w-full cs2-slider amber" />
        </div>

        <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="flex justify-between text-xs">
            <span class="text-slate-300 font-semibold">{t('viewmodel.offsetZ')}</span>
            <span id="val-vm-z" class="font-mono text-amber-300 font-bold">-1.5</span>
          </div>
          <input id="vm-offset-z" type="range" min="-2" max="2" step="0.1" class="w-full cs2-slider amber" />
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold text-slate-400 uppercase mr-1">{t('viewmodel.presetPos')}</span>
          <button type="button" data-vm-preset="1" class="px-3 py-1.5 rounded-lg border text-xs font-medium cursor-pointer transition-colors">{t('viewmodel.presetDesktop')}</button>
          <button type="button" data-vm-preset="2" class="px-3 py-1.5 rounded-lg border text-xs font-medium cursor-pointer transition-colors">{t('viewmodel.presetCouch')}</button>
          <button type="button" data-vm-preset="3" class="px-3 py-1.5 rounded-lg border text-xs font-medium cursor-pointer transition-colors">{t('viewmodel.presetClassic')}</button>
        </div>

        <button id="btn-vm-reset" type="button" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600 text-xs text-slate-200 cursor-pointer">
          {t('viewmodel.resetDefault')}
        </button>
      </div>

      <div class="p-4 rounded-xl bg-slate-950/90 border border-slate-800 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-mono text-slate-400">CS2 Viewmodel ConVars</span>
          <button id="btn-vm-copy" type="button" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-[11px] font-semibold text-cyan-300 cursor-pointer">
            {t('common.copy')}
          </button>
        </div>
        <pre id="vm-convars-preview" dir="ltr" class="font-mono text-xs text-amber-300 whitespace-pre-wrap leading-relaxed text-left"></pre>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountViewmodelPage } from '../scripts/viewmodelStudio.js';
  mountViewmodelPage();
</script>
