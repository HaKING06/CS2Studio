---
import { getDictionary, translateKey } from '../utils/i18n.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const t = (key: string) => translateKey(dict, key);
---

<section id="buy-binds-section" class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">{t('buyBinds.title')}</h1>
      <p class="text-sm text-slate-400 mt-1">{t('buyBinds.subtitle')}</p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <button id="btn-preset-numpad" type="button" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-700 hover:border-cyan-400 text-xs font-medium text-cyan-300 cursor-pointer">
        {t('buyBinds.presetProNumpad')}
      </button>
      <button id="btn-preset-fkeys" type="button" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-700 hover:border-cyan-400 text-xs font-medium text-slate-200 cursor-pointer">
        {t('buyBinds.presetFKeys')}
      </button>
      <button id="btn-clear-binds" type="button" class="px-3 py-1.5 rounded-lg bg-rose-950/60 border border-rose-500/40 hover:border-rose-400 text-xs font-medium text-rose-300 cursor-pointer">
        {t('buyBinds.clearAll')}
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
    <!-- Weapon Palette -->
    <div class="xl:col-span-4 cs2-glass rounded-2xl p-4 space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold uppercase tracking-wider text-white">{t('buyBinds.paletteTitle')}</h2>
        <span class="text-[11px] font-mono text-amber-400">SortableJS + DnD</span>
      </div>

      <div class="flex flex-wrap gap-1.5 text-[11px]">
        <button type="button" data-buy-cat="all" class="px-2 py-1 rounded-md border cursor-pointer">All</button>
        <button type="button" data-buy-cat="rifles" class="px-2 py-1 rounded-md border cursor-pointer">{t('buyBinds.catRifles')}</button>
        <button type="button" data-buy-cat="smg" class="px-2 py-1 rounded-md border cursor-pointer">{t('buyBinds.catSmg')}</button>
        <button type="button" data-buy-cat="pistols" class="px-2 py-1 rounded-md border cursor-pointer">{t('buyBinds.catPistols')}</button>
        <button type="button" data-buy-cat="utility" class="px-2 py-1 rounded-md border cursor-pointer">{t('buyBinds.catUtility')}</button>
      </div>

      <div id="buy-palette-list" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-1 gap-2 max-h-[440px] overflow-y-auto pr-1"></div>
    </div>

    <!-- Mechanical Keyboard + Output -->
    <div class="xl:col-span-8 space-y-5">
      <div class="cs2-glass rounded-2xl p-5 space-y-4 overflow-x-auto">
        <div class="flex items-center justify-between text-xs text-slate-400 min-w-[640px]">
          <span>{t('buyBinds.clickKeyHint')}</span>
          <span>
            {t('buyBinds.bindCount')}: <strong id="buy-bind-count" class="text-cyan-300 font-mono">0</strong>
          </span>
        </div>

        <div dir="ltr" class="min-w-[640px] space-y-4">
          <div id="kb-f-row" class="grid grid-cols-12 gap-2"></div>

          <div class="grid grid-cols-12 gap-4 items-start pt-1">
            <div class="col-span-4 space-y-4">
              <div id="kb-nav-cluster" class="grid grid-cols-3 gap-2"></div>
              <div id="kb-arrow-cluster" class="grid grid-cols-3 gap-2 pt-2"></div>
            </div>
            <div class="col-span-8">
              <div id="kb-numpad-grid" class="grid grid-cols-4 gap-2"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="cs2-glass rounded-2xl p-4 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-cyan-300">{t('buyBinds.generatedCommands')}</span>
          <div class="flex items-center gap-2">
            <span class="text-[11px] font-mono text-slate-500">bind "KEY" "buy ...;"</span>
            <button id="btn-copy-binds" type="button" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-[11px] font-semibold text-cyan-300 cursor-pointer">
              {t('common.copy')}
            </button>
          </div>
        </div>
        <pre id="buy-binds-preview" dir="ltr" class="p-3 rounded-xl bg-slate-950/90 border border-slate-800 text-xs font-mono text-emerald-300 max-h-48 overflow-y-auto whitespace-pre-wrap text-left"></pre>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountBuyBindsPage } from '../scripts/buyBindsStudio.js';
  mountBuyBindsPage();
</script>
