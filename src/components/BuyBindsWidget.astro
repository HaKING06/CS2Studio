---
import { getDictionary, translateKey } from '../utils/i18n.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const t = (key: string) => translateKey(dict, key);
---

<section id="buy-binds-section" class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-800/80 pb-4">
    <div>
      <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-[#ff9d00] font-semibold">SortableJS • bind KEY "buy ...;"</span>
      <h1 class="font-display text-3xl sm:text-5xl font-bold uppercase text-white tracking-wide mt-0.5 leading-none">{t('buyBinds.title')}</h1>
      <p class="text-sm text-slate-400 mt-1.5">{t('buyBinds.subtitle')}</p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <button id="btn-preset-numpad" type="button" class="px-3 py-1.5 rounded-sm bg-[#0b0f17] border border-slate-700 hover:border-[#ff9d00] text-xs font-semibold text-[#ff9d00] cursor-pointer transition-colors">
        {t('buyBinds.presetProNumpad')}
      </button>
      <button id="btn-preset-fkeys" type="button" class="px-3 py-1.5 rounded-sm bg-[#0b0f17] border border-slate-700 hover:border-[#ff9d00] text-xs font-semibold text-slate-200 cursor-pointer transition-colors">
        {t('buyBinds.presetFKeys')}
      </button>
      <button id="btn-clear-binds" type="button" class="px-3 py-1.5 rounded-sm bg-rose-950/60 border border-rose-500/40 hover:border-rose-400 text-xs font-semibold text-rose-300 cursor-pointer transition-colors">
        {t('buyBinds.clearAll')}
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
    <!-- Weapon Palette -->
    <div class="xl:col-span-4 cs2-panel rounded-sm p-4 space-y-3 border-t-2 border-t-[#ff9d00]">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-xl uppercase tracking-wider font-bold text-white">{t('buyBinds.paletteTitle')}</h2>
        <span class="text-[11px] font-mono text-[#ff9d00]">SortableJS + DnD</span>
      </div>

      <div class="flex flex-wrap gap-1.5 text-[11px]">
        <button type="button" data-buy-cat="all" class="px-2.5 py-1 rounded-sm border font-semibold cursor-pointer">All</button>
        <button type="button" data-buy-cat="rifles" class="px-2.5 py-1 rounded-sm border font-semibold cursor-pointer">{t('buyBinds.catRifles')}</button>
        <button type="button" data-buy-cat="smg" class="px-2.5 py-1 rounded-sm border font-semibold cursor-pointer">{t('buyBinds.catSmg')}</button>
        <button type="button" data-buy-cat="pistols" class="px-2.5 py-1 rounded-sm border font-semibold cursor-pointer">{t('buyBinds.catPistols')}</button>
        <button type="button" data-buy-cat="utility" class="px-2.5 py-1 rounded-sm border font-semibold cursor-pointer">{t('buyBinds.catUtility')}</button>
      </div>

      <div id="buy-palette-list" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-1 gap-2 max-h-[440px] overflow-y-auto pr-1"></div>
    </div>

    <!-- Mechanical Keyboard + Output -->
    <div class="xl:col-span-8 space-y-5">
      <div class="cs2-panel rounded-sm p-5 space-y-4 overflow-x-auto border-t-2 border-t-[#ff9d00]">
        <div class="flex items-center justify-between text-xs text-slate-400 min-w-[640px]">
          <span>{t('buyBinds.clickKeyHint')}</span>
          <span>
            {t('buyBinds.bindCount')}: <strong id="buy-bind-count" class="text-[#ff9d00] font-mono">0</strong>
          </span>
        </div>

        <div dir="ltr" class="min-w-[640px] space-y-4">
          <div id="kb-f-row" class="grid grid-cols-12 gap-2"></div>

          <div class="grid grid-cols-12 gap-4 items-start pt-1">
            <div class="col-span-4 space-y-4">
              <div id="kb-nav-cluster" class="grid grid-cols-3 gap-2"></div>
              <div id="kb-arrow-cluster" class="grid grid-cols-3 gap-2 pt-2"></div>
            </div>
            <div class="col-span-8">
              <div id="kb-numpad-grid" class="grid grid-cols-4 gap-2"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="cs2-panel rounded-sm p-4 space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-display text-lg uppercase tracking-wider font-bold text-white">{t('buyBinds.generatedCommands')}</span>
          <div class="flex items-center gap-2">
            <span class="text-[11px] font-mono text-slate-500">bind "KEY" "buy ...;"</span>
            <button id="btn-copy-binds" type="button" class="px-2.5 py-1 rounded-sm bg-slate-800 hover:bg-slate-700 text-[11px] font-bold uppercase text-[#ff9d00] cursor-pointer">
              {t('common.copy')}
            </button>
          </div>
        </div>
        <pre id="buy-binds-preview" dir="ltr" class="p-3 rounded-sm bg-[#080b11] border border-slate-800 text-xs font-mono text-amber-300 max-h-48 overflow-y-auto whitespace-pre-wrap text-left"></pre>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountBuyBindsPage } from '../scripts/buyBindsStudio.js';
  mountBuyBindsPage();
</script>
