---
import { getDictionary, translateKey } from '../utils/i18n.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const t = (key: string) => translateKey(dict, key);
---

<section id="arena-section" class="space-y-6">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <span class="text-xs font-mono uppercase tracking-wider text-cyan-400">{t('arena.modelStatus')}</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mt-1">{t('arena.title')}</h1>
      <p class="text-sm text-slate-400 mt-1">{t('pages.arenaDesc')}</p>
    </div>

    <div class="flex flex-wrap items-center gap-2 text-xs">
      <div class="cs2-glass px-3 py-1.5 rounded-lg flex items-center gap-2">
        <span class="text-slate-400">{t('arena.shotsFired')}:</span>
        <span id="stat-shots" class="font-mono font-bold text-white">0</span>
      </div>
      <div class="cs2-glass px-3 py-1.5 rounded-lg flex items-center gap-2">
        <span class="text-slate-400">{t('arena.headshotRate')}:</span>
        <span id="stat-hits" class="font-mono font-bold text-cyan-300">0</span>
      </div>
      <div class="cs2-glass px-3 py-1.5 rounded-lg flex items-center gap-2">
        <span class="text-slate-400">{t('arena.accuracy')}:</span>
        <span id="stat-accuracy" class="font-mono font-bold text-amber-400">100%</span>
      </div>
    </div>
  </div>

  <!-- Arena Toolbar -->
  <div class="cs2-glass rounded-2xl p-4 flex flex-wrap items-center justify-between gap-4">
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-2">
        <label for="arena-weapon" class="text-xs font-semibold text-slate-400 uppercase">{t('arena.weapon')}</label>
        <select
          id="arena-weapon"
          class="bg-slate-900 border border-slate-700 text-white text-xs sm:text-sm rounded-lg px-3 py-2 focus:border-cyan-400 focus:outline-none"
        ></select>
      </div>

      <div class="flex items-center gap-1.5">
        <span class="text-xs font-semibold text-slate-400 uppercase hidden sm:inline">{t('arena.range')}</span>
        <button type="button" data-arena-range="10" class="px-2.5 py-1.5 text-xs font-mono rounded-lg border transition-colors cursor-pointer">10m</button>
        <button type="button" data-arena-range="20" class="px-2.5 py-1.5 text-xs font-mono rounded-lg border transition-colors cursor-pointer">20m</button>
        <button type="button" data-arena-range="35" class="px-2.5 py-1.5 text-xs font-mono rounded-lg border transition-colors cursor-pointer">35m</button>
      </div>

      <div class="flex items-center gap-1.5">
        <button type="button" data-arena-mode="control" class="px-2.5 py-1.5 text-xs font-medium rounded-lg border transition-colors cursor-pointer">
          {t('arena.modeSprayControl')}
        </button>
        <button type="button" data-arena-mode="wall" class="px-2.5 py-1.5 text-xs font-medium rounded-lg border transition-colors cursor-pointer">
          {t('arena.modePatternWall')}
        </button>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2.5">
      <label class="inline-flex items-center gap-2 text-xs text-slate-300 cursor-pointer select-none px-2.5 py-1.5 rounded-lg bg-slate-900/70 border border-slate-700/80">
        <input id="arena-ghost-toggle" type="checkbox" class="accent-cyan-400 rounded cursor-pointer" />
        <span>{t('arena.showGhost')}</span>
      </label>

      <button id="btn-sound-toggle" type="button" title="Audio SFX" class="px-2.5 py-1.5 text-xs rounded-lg border border-slate-700 bg-slate-900/80 text-cyan-300 hover:border-cyan-400 cursor-pointer">
        🔊 SFX
      </button>

      <button id="btn-pointer-lock" type="button" class="px-2.5 py-1.5 text-xs rounded-lg border border-slate-700 bg-slate-900/80 text-slate-200 hover:border-cyan-400 cursor-pointer">
        🎯 FPS Lock
      </button>

      <button id="btn-clear-decals" type="button" class="px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-700 bg-slate-900/80 text-slate-200 hover:border-amber-400/70 cursor-pointer">
        {t('arena.clearDecals')}
      </button>

      <button id="btn-reset-stats" type="button" class="px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-700 bg-slate-900/80 text-slate-400 hover:text-white cursor-pointer">
        {t('arena.resetStats')}
      </button>
    </div>
  </div>

  <!-- 3D WebGL Arena + Controls -->
  <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
    <div class="xl:col-span-8 space-y-4">
      <div
        id="arena-stage"
        class="relative w-full aspect-[16/9] min-h-[340px] rounded-2xl overflow-hidden border border-cyan-500/25 shadow-[0_25px_70px_rgba(0,0,0,0.65)] bg-slate-950 select-none"
      >
        <canvas id="arena-webgl" class="w-full h-full block"></canvas>
        <canvas id="arena-crosshair" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>

        <div class="pointer-events-none absolute top-3 left-3 flex items-center gap-2">
          <span id="arena-weapon-badge" class="px-2.5 py-1 rounded-md bg-slate-950/75 border border-slate-700/80 text-xs font-mono font-bold text-amber-300 backdrop-blur-sm">
            AK-47 • $2700
          </span>
        </div>

        <div class="pointer-events-none absolute bottom-3 left-3 right-3 flex items-center justify-between gap-2 text-xs">
          <div class="px-3 py-1.5 rounded-lg bg-slate-950/75 border border-slate-700/70 text-slate-300 backdrop-blur-sm">
            {t('arena.fireHint')}
          </div>
          <div id="arena-mag-counter" class="px-3 py-1.5 rounded-lg bg-slate-950/80 border border-cyan-500/30 font-mono font-bold text-cyan-300 backdrop-blur-sm">
            30 / 30
          </div>
        </div>
      </div>

      <p class="text-xs font-mono text-slate-400">
        {t('arena.dropGlbHint')} • <code class="text-cyan-400">/public/models/</code>
      </p>

      <!-- Pro Crosshair Database -->
      <div class="cs2-glass rounded-2xl p-5 space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-sm font-bold uppercase tracking-wider text-cyan-300">{t('arena.proDatabase')}</h2>
          <div class="flex items-center gap-2 w-full sm:w-auto">
            <input
              id="crosshair-share-code"
              dir="ltr"
              type="text"
              placeholder="CSGO-... / CS..."
              aria-label={t('arena.shareCode')}
              class="flex-1 sm:w-72 bg-slate-950/90 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs font-mono text-amber-200 focus:border-cyan-400 focus:outline-none"
            />
            <button id="btn-import-crosshair" type="button" class="px-2.5 py-1.5 rounded-lg bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-400/60 text-cyan-200 text-xs font-semibold cursor-pointer">
              {t('arena.importCode')}
            </button>
            <button id="btn-copy-crosshair" type="button" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600 text-slate-200 text-xs font-semibold cursor-pointer">
              {t('arena.copyCode')}
            </button>
          </div>
        </div>
        <div id="pro-crosshair-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5"></div>
      </div>
    </div>

    <!-- Crosshair Studio Panel -->
    <div class="xl:col-span-4 cs2-glass rounded-2xl p-5 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h2 class="text-base font-bold text-white">{t('arena.crosshairEditor')}</h2>
        <span class="text-[11px] font-mono text-cyan-400">cl_crosshair*</span>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="ch-style" class="block text-xs text-slate-400 mb-1">{t('arena.style')}</label>
          <select id="ch-style" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:border-cyan-400 focus:outline-none">
            <option value="4">{t('arena.styleStatic')}</option>
            <option value="2">{t('arena.styleDynamic')}</option>
            <option value="0">{t('arena.styleHybrid')}</option>
            <option value="6">Dot Only (6)</option>
          </select>
        </div>
        <div>
          <label for="ch-outline" class="block text-xs text-slate-400 mb-1">{t('arena.outline')}</label>
          <select id="ch-outline" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:border-cyan-400 focus:outline-none">
            <option value="0">Off</option>
            <option value="1">Full Outline</option>
            <option value="2">Half Outline</option>
          </select>
        </div>
      </div>

      <div class="space-y-3">
        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{t('arena.size')}</span>
            <span id="val-ch-length" class="font-mono text-cyan-300">2</span>
          </div>
          <input id="ch-length" type="range" min="0" max="20" step="1" class="w-full cs2-slider" />
        </div>

        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{t('arena.thickness')}</span>
            <span id="val-ch-thickness" class="font-mono text-cyan-300">2</span>
          </div>
          <input id="ch-thickness" type="range" min="1" max="10" step="1" class="w-full cs2-slider" />
        </div>

        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{t('arena.gap')}</span>
            <span id="val-ch-gap" class="font-mono text-cyan-300">1</span>
          </div>
          <input id="ch-gap" type="range" min="-8" max="15" step="1" class="w-full cs2-slider" />
        </div>

        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{t('arena.alpha')}</span>
            <span id="val-ch-alpha" class="font-mono text-cyan-300">255</span>
          </div>
          <input id="ch-alpha" type="range" min="50" max="255" step="5" class="w-full cs2-slider" />
        </div>

        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{t('arena.sniperWidth')}</span>
            <span id="val-ch-sniper" class="font-mono text-cyan-300">1</span>
          </div>
          <input id="ch-sniper-width" type="range" min="1" max="5" step="1" class="w-full cs2-slider" />
        </div>
      </div>

      <div class="pt-1">
        <div class="flex items-center justify-between text-xs mb-2">
          <span class="text-slate-300">{t('arena.color')}</span>
          <input id="ch-color-picker" type="color" aria-label={t('arena.color')} class="w-7 h-6 rounded cursor-pointer bg-transparent border-0 p-0" />
        </div>
        <div id="ch-color-swatches" class="flex flex-wrap gap-2"></div>
      </div>

      <div class="grid grid-cols-1 gap-2 pt-2 border-t border-slate-800">
        <label class="flex items-center justify-between p-2 rounded-lg bg-slate-900/60 border border-slate-800 text-xs text-slate-200 cursor-pointer">
          <span>{t('arena.dot')}</span>
          <input id="ch-dot" type="checkbox" class="accent-cyan-400 cursor-pointer" />
        </label>
        <label class="flex items-center justify-between p-2 rounded-lg bg-slate-900/60 border border-slate-800 text-xs text-slate-200 cursor-pointer">
          <span>{t('arena.tStyle')}</span>
          <input id="ch-tstyle" type="checkbox" class="accent-cyan-400 cursor-pointer" />
        </label>
        <label class="flex items-center justify-between p-2 rounded-lg bg-slate-900/60 border border-slate-800 text-xs text-slate-200 cursor-pointer">
          <span>{t('arena.followRecoil')}</span>
          <input id="ch-follow-recoil" type="checkbox" class="accent-amber-400 cursor-pointer" />
        </label>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountSprayArenaPage } from '../scripts/sprayArena.js';
  mountSprayArenaPage();
</script>
