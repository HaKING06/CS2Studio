---
import { getDictionary, getLocalizedPath, translateKey } from '../utils/i18n.js';
import ProDatabaseSection from './ProDatabaseSection.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const t = (key: string) => translateKey(dict, key);
---

<section id="arena-section" class="space-y-6">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-800/80 pb-4">
    <div>
      <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-[#ff9d00] font-semibold">de_dust2 • {t('arena.modelStatus')}</span>
      <h1 class="font-display text-3xl sm:text-5xl font-bold uppercase text-white tracking-wide mt-0.5 leading-none">{t('arena.title')}</h1>
      <p class="text-sm text-slate-400 mt-1.5">{t('pages.arenaDesc')}</p>
    </div>

    <div class="flex flex-wrap items-center gap-2 text-xs">
      <div class="cs2-panel px-3 py-2 rounded-sm flex items-center gap-2">
        <span class="text-slate-400 uppercase font-mono text-[10px]">{t('arena.shotsFired')}</span>
        <span id="stat-shots" class="font-mono font-bold text-white text-sm">0</span>
      </div>
      <div class="cs2-panel px-3 py-2 rounded-sm flex items-center gap-2">
        <span class="text-slate-400 uppercase font-mono text-[10px]">{t('arena.headshotRate')}</span>
        <span id="stat-hits" class="font-mono font-bold text-emerald-400 text-sm">0</span>
      </div>
      <div class="cs2-panel px-3 py-2 rounded-sm flex items-center gap-2 border-t-2 border-t-[#ff9d00]">
        <span class="text-slate-400 uppercase font-mono text-[10px]">{t('arena.accuracy')}</span>
        <span id="stat-accuracy" class="font-mono font-bold text-[#ff9d00] text-sm">100%</span>
      </div>
    </div>
  </div>

  <!-- Arena Toolbar -->
  <div class="cs2-panel rounded-sm p-4 flex flex-wrap items-center justify-between gap-4">
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-2">
        <label for="arena-weapon" class="text-[11px] font-mono font-bold text-slate-400 uppercase">{t('arena.weapon')}</label>
        <select
          id="arena-weapon"
          class="bg-[#0b0f17] border border-slate-700 text-white text-xs sm:text-sm rounded-sm px-3 py-1.5 focus:border-[#ff9d00] focus:outline-none"
        ></select>
      </div>

      <div class="flex items-center gap-1.5">
        <span class="text-[11px] font-mono font-bold text-slate-400 uppercase hidden sm:inline">{t('arena.range')}</span>
        <button type="button" data-arena-range="10" class="px-2.5 py-1.5 text-xs font-mono rounded-sm border transition-colors cursor-pointer">10m</button>
        <button type="button" data-arena-range="20" class="px-2.5 py-1.5 text-xs font-mono rounded-sm border transition-colors cursor-pointer">20m</button>
        <button type="button" data-arena-range="35" class="px-2.5 py-1.5 text-xs font-mono rounded-sm border transition-colors cursor-pointer">35m</button>
      </div>

      <div class="flex items-center gap-1.5">
        <button type="button" data-arena-mode="control" class="px-2.5 py-1.5 text-xs font-semibold rounded-sm border transition-colors cursor-pointer">
          {t('arena.modeSprayControl')}
        </button>
        <button type="button" data-arena-mode="wall" class="px-2.5 py-1.5 text-xs font-semibold rounded-sm border transition-colors cursor-pointer">
          {t('arena.modePatternWall')}
        </button>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <label class="inline-flex items-center gap-2 text-xs text-slate-300 cursor-pointer select-none px-2.5 py-1.5 rounded-sm bg-[#0b0f17] border border-slate-700/80">
        <input id="arena-ghost-toggle" type="checkbox" class="accent-[#ff9d00] rounded-sm cursor-pointer" />
        <span>{t('arena.showGhost')}</span>
      </label>

      <button id="btn-sound-toggle" type="button" title="Audio SFX" class="px-2.5 py-1.5 text-xs font-mono rounded-sm border border-slate-700 bg-[#0b0f17] text-[#ff9d00] hover:border-[#ff9d00] cursor-pointer">
        🔊 SFX
      </button>

      <button id="btn-pointer-lock" type="button" class="px-2.5 py-1.5 text-xs font-mono rounded-sm border border-slate-700 bg-[#0b0f17] text-slate-200 hover:border-[#ff9d00] cursor-pointer">
        🎯 FPS LOCK
      </button>

      <button id="btn-clear-decals" type="button" class="px-3 py-1.5 text-xs font-semibold rounded-sm border border-slate-700 bg-[#0b0f17] text-slate-200 hover:border-[#ff9d00] cursor-pointer">
        {t('arena.clearDecals')}
      </button>

      <button id="btn-reset-stats" type="button" class="px-3 py-1.5 text-xs font-semibold rounded-sm border border-slate-700 bg-[#0b0f17] text-slate-400 hover:text-white cursor-pointer">
        {t('arena.resetStats')}
      </button>
    </div>
  </div>

  <!-- 3D WebGL Arena + Controls -->
  <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
    <div class="xl:col-span-8 space-y-4">
      <div
        id="arena-stage"
        class="relative w-full aspect-[16/9] min-h-[340px] rounded-sm overflow-hidden border border-[#ff9d00]/30 shadow-[0_25px_70px_rgba(0,0,0,0.7)] bg-[#080b11] select-none"
      >
        <img id="arena-fallback-bg" src="/assets/maps/de_dust2_site.webp" alt="Counter-Strike 2 Dust2 A-Site" class="hidden absolute inset-0 w-full h-full object-cover select-none" />
        <canvas id="arena-webgl" class="relative w-full h-full block"></canvas>
        <canvas id="arena-crosshair" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>

        <div class="pointer-events-none absolute top-3 left-3 flex flex-wrap items-center gap-2">
          <span id="arena-weapon-badge" class="px-2.5 py-1 rounded-sm bg-[#080b11]/85 border border-slate-700/80 text-xs font-mono font-bold text-[#ff9d00] backdrop-blur-sm">
            AK-47 • $2700
          </span>
          <span id="arena-map-badge" class="px-2.5 py-1 rounded-sm bg-[#080b11]/85 border border-slate-700/80 text-[11px] font-mono text-slate-300 backdrop-blur-sm">
            de_dust2 • Long A
          </span>
        </div>

        <div class="pointer-events-none absolute bottom-3 left-3 right-3 flex items-center justify-between gap-2 text-xs">
          <div class="px-3 py-1.5 rounded-sm bg-[#080b11]/85 border border-slate-700/70 text-slate-300 backdrop-blur-sm">
            {t('arena.fireHint')}
          </div>
          <div id="arena-mag-counter" class="px-3 py-1.5 rounded-sm bg-[#080b11]/90 border border-[#ff9d00]/40 font-mono font-bold text-[#ff9d00] backdrop-blur-sm">
            30 / 30
          </div>
        </div>
      </div>

      <p class="text-xs font-mono text-slate-400">
        {t('arena.dropGlbHint')} • <code class="text-[#ff9d00]">/public/models/</code>
      </p>

      <!-- Massive Esports Pro Crosshair Database (2012-2026) -->
      <ProDatabaseSection lang={lang} />
    </div>

    <!-- Crosshair Quick Studio Panel -->
    <div class="xl:col-span-4 cs2-panel rounded-sm p-5 space-y-4 border-t-2 border-t-[#ff9d00]">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h2 class="font-display text-2xl uppercase tracking-wider font-bold text-white leading-none">{t('arena.crosshairEditor')}</h2>
        <a
          href={getLocalizedPath(lang, 'crosshair', true)}
          class="text-[11px] font-mono font-bold text-[#ff9d00] hover:underline"
        >
          /crosshair →
        </a>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="ch-style" class="block text-xs text-slate-400 mb-1">{t('arena.style')}</label>
          <select id="ch-style" class="w-full bg-[#0b0f17] border border-slate-700 rounded-sm px-2.5 py-1.5 text-xs text-white focus:border-[#ff9d00] focus:outline-none">
            <option value="4">{t('arena.styleStatic')}</option>
            <option value="2">{t('arena.styleDynamic')}</option>
            <option value="0">{t('arena.styleHybrid')}</option>
            <option value="6">Dot Only (6)</option>
          </select>
        </div>
        <div>
          <label for="ch-outline" class="block text-xs text-slate-400 mb-1">{t('arena.outline')}</label>
          <select id="ch-outline" class="w-full bg-[#0b0f17] border border-slate-700 rounded-sm px-2.5 py-1.5 text-xs text-white focus:border-[#ff9d00] focus:outline-none">
            <option value="0">Off</option>
            <option value="1">Full Outline</option>
            <option value="2">Half Outline</option>
          </select>
        </div>
      </div>

      <div class="space-y-3">
        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{t('arena.size')}</span>
            <span id="val-ch-length" class="font-mono text-[#ff9d00]">2</span>
          </div>
          <input id="ch-length" type="range" min="0" max="20" step="1" class="w-full cs2-slider" />
        </div>

        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{t('arena.thickness')}</span>
            <span id="val-ch-thickness" class="font-mono text-[#ff9d00]">2</span>
          </div>
          <input id="ch-thickness" type="range" min="1" max="10" step="1" class="w-full cs2-slider" />
        </div>

        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{t('arena.gap')}</span>
            <span id="val-ch-gap" class="font-mono text-[#ff9d00]">1</span>
          </div>
          <input id="ch-gap" type="range" min="-8" max="15" step="1" class="w-full cs2-slider" />
        </div>

        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{t('arena.outlineThickness')}</span>
            <span id="val-ch-outline-thickness" class="font-mono text-[#ff9d00]">1.0</span>
          </div>
          <input id="ch-outline-thickness" type="range" min="0" max="3" step="0.5" class="w-full cs2-slider" />
        </div>

        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{t('arena.alpha')}</span>
            <span id="val-ch-alpha" class="font-mono text-[#ff9d00]">255</span>
          </div>
          <input id="ch-alpha" type="range" min="50" max="255" step="5" class="w-full cs2-slider" />
        </div>

        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{t('arena.sniperWidth')}</span>
            <span id="val-ch-sniper" class="font-mono text-[#ff9d00]">1</span>
          </div>
          <input id="ch-sniper-width" type="range" min="1" max="5" step="1" class="w-full cs2-slider" />
        </div>
      </div>

      <div class="pt-1">
        <div class="flex items-center justify-between text-xs mb-2">
          <span class="text-slate-300">{t('arena.color')}</span>
          <input id="ch-color-picker" type="color" aria-label={t('arena.color')} class="w-7 h-6 rounded-sm cursor-pointer bg-transparent border-0 p-0" />
        </div>
        <div id="ch-color-swatches" class="flex flex-wrap gap-2"></div>
      </div>

      <div class="grid grid-cols-1 gap-2 pt-2 border-t border-slate-800">
        <label class="flex items-center justify-between p-2 rounded-sm bg-[#0b0f17] border border-slate-800 text-xs text-slate-200 cursor-pointer">
          <span>{t('arena.dot')}</span>
          <input id="ch-dot" type="checkbox" class="accent-[#ff9d00] cursor-pointer" />
        </label>
        <label class="flex items-center justify-between p-2 rounded-sm bg-[#0b0f17] border border-slate-800 text-xs text-slate-200 cursor-pointer">
          <span>{t('arena.tStyle')}</span>
          <input id="ch-tstyle" type="checkbox" class="accent-[#ff9d00] cursor-pointer" />
        </label>
        <label class="flex items-center justify-between p-2 rounded-sm bg-[#0b0f17] border border-[#ff9d00]/30 text-xs text-[#ff9d00] font-semibold cursor-pointer">
          <span>{t('arena.followRecoil')}</span>
          <input id="ch-follow-recoil" type="checkbox" class="accent-[#ff9d00] cursor-pointer" />
        </label>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountSprayArenaPage } from '../scripts/sprayArena.js';
  mountSprayArenaPage();
</script>
