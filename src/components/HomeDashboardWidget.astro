---
import { getDictionary, getLocalizedPath, translateKey } from '../utils/i18n.js';

interface Props {
  lang: string;
  isPrefixed: boolean;
}

const { lang, isPrefixed } = Astro.props;
const dict = getDictionary(lang);
const t = (key: string) => translateKey(dict, key);

const cards = [
  {
    key: 'spray-arena' as const,
    icon: '🎯',
    tag: 'WEBGL • DUST2',
    title: t('nav.arena'),
    desc: t('pages.arenaDesc'),
    statusId: 'dash-crosshair-code',
    previewId: 'dash-crosshair-preview',
  },
  {
    key: 'crosshair' as const,
    icon: '✛',
    tag: 'FOLLOW RECOIL',
    title: t('nav.crosshair'),
    desc: t('pages.crosshairDesc'),
    statusId: null,
  },
  {
    key: 'viewmodel' as const,
    icon: '🔫',
    tag: 'SOURCE 2 HD',
    title: t('nav.viewmodel'),
    desc: t('pages.viewmodelDesc'),
    statusId: 'dash-viewmodel-summary',
  },
  {
    key: 'buy-binds' as const,
    icon: '⌨️',
    tag: 'SORTABLE DND',
    title: t('nav.buyBinds'),
    desc: t('pages.buyBindsDesc'),
    statusId: 'dash-binds-count',
  },
  {
    key: 'autoexec' as const,
    icon: '📦',
    tag: 'CFG COMPILER',
    title: t('nav.autoexec'),
    desc: t('pages.autoexecDesc'),
    statusId: null,
  },
];
---

<section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mb-12 pt-2">
  <div class="lg:col-span-7 space-y-5">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-[#ff9d00]/12 border border-[#ff9d00]/40 text-[#ff9d00] text-[11px] font-mono font-bold uppercase tracking-wider">
      <span class="w-2 h-2 rounded-full bg-[#ff9d00] animate-pulse"></span>
      <span>{t('hero.badge')}</span>
    </div>

    <h1 class="font-display text-4xl sm:text-6xl font-bold uppercase tracking-wide text-white leading-[0.95]">
      {t('hero.title')}
    </h1>

    <p class="text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
      {t('hero.subtitle')}
    </p>

    <div class="flex flex-wrap items-center gap-3 pt-1">
      <a
        href={getLocalizedPath(lang, 'spray-arena', isPrefixed)}
        class="px-6 py-3 rounded-sm cs2-chamfer font-bold text-xs sm:text-sm uppercase tracking-wider bg-[#ff9d00] hover:bg-amber-400 text-[#0b0f17] shadow-[0_0_28px_rgba(255,157,0,0.35)] transition-all hover:scale-[1.02]"
      >
        {t('nav.arena')} →
      </a>
      <a
        href={getLocalizedPath(lang, 'crosshair', isPrefixed)}
        class="px-5 py-3 rounded-sm font-bold text-xs sm:text-sm uppercase tracking-wider bg-slate-900 hover:bg-slate-800 border border-[#ff9d00]/50 text-[#ff9d00] transition-all"
      >
        {t('nav.crosshair')}
      </a>
      <a
        href={getLocalizedPath(lang, 'autoexec', isPrefixed)}
        class="px-5 py-3 rounded-sm font-bold text-xs sm:text-sm uppercase tracking-wider bg-slate-900 hover:bg-slate-800 border border-slate-700 hover:border-slate-500 text-white transition-all"
      >
        {t('autoexec.downloadCfg')}
      </a>
    </div>
  </div>

  <div class="lg:col-span-5">
    <div class="cs2-panel rounded-sm p-1.5 border-t-2 border-t-[#ff9d00] overflow-hidden shadow-[0_25px_60px_rgba(0,0,0,0.65)]">
      <img
        src="/assets/promo-banner.png"
        alt="CS2 Studio v0.1.0 — 3D Dust2 Spray Arena & Esports Crosshair Database"
        width="1376"
        height="768"
        class="w-full h-auto rounded-sm object-cover"
      />
    </div>
  </div>
</section>

<section class="mb-10">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-5 border-b border-slate-800 pb-3">
    <h2 class="font-display text-2xl sm:text-3xl font-bold uppercase tracking-wider text-white leading-none">{t('home.featuresTitle')}</h2>
    <span class="text-[11px] font-mono text-[#ff9d00] bg-[#ff9d00]/10 border border-[#ff9d00]/30 px-2.5 py-1 rounded-sm">
      {t('home.syncedBadge')}
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
    {cards.map((card) => (
      <a
        href={getLocalizedPath(lang, card.key, isPrefixed)}
        class="cs2-panel rounded-sm p-5 border border-slate-800 hover:border-[#ff9d00]/80 border-t-2 border-t-[#ff9d00]/70 transition-all group flex flex-col justify-between gap-4 hover:-translate-y-0.5"
      >
        <div class="space-y-3">
          <div class="flex items-start justify-between gap-3">
            <div class="space-y-1">
              <span class="inline-block text-[10px] font-mono font-bold tracking-widest text-[#ff9d00]">{card.tag}</span>
              <div class="flex items-center gap-2.5">
                <span class="text-xl" aria-hidden="true">{card.icon}</span>
                <h3 class="font-display text-2xl uppercase font-bold text-white group-hover:text-[#ff9d00] transition-colors leading-none">{card.title}</h3>
              </div>
            </div>
            {card.previewId && (
              <div id={card.previewId} class="w-11 h-11 rounded-sm bg-[#080b11] border border-slate-700/80 flex items-center justify-center shrink-0"></div>
            )}
          </div>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">{card.desc}</p>
        </div>

        <div class="flex items-center justify-between gap-2 pt-3 border-t border-slate-800/80">
          {card.statusId ? (
            <span id={card.statusId} class="text-[11px] font-mono px-2 py-0.5 rounded-sm bg-[#080b11] text-amber-300 border border-slate-700 truncate max-w-[200px]">
              Synced
            </span>
          ) : (
            <span class="text-[11px] font-mono text-slate-500">CS2 Studio v0.1.0</span>
          )}
          <span class="text-xs font-bold uppercase tracking-wider text-[#ff9d00] group-hover:translate-x-0.5 transition-transform">
            {t('home.openModule')} →
          </span>
        </div>
      </a>
    ))}
  </div>
</section>

<script>
  import { mountHomeDashboard } from '../scripts/homeDashboard.js';
  mountHomeDashboard();
</script>
