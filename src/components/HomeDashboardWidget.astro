---
import { getDictionary, getLocalizedPath, translateKey } from '../utils/i18n.js';

interface Props {
  lang: string;
  isPrefixed: boolean;
}

const { lang, isPrefixed } = Astro.props;
const dict = getDictionary(lang);
const t = (key: string) => translateKey(dict, key);

const cards = [
  {
    key: 'spray-arena' as const,
    icon: '🎯',
    accent: 'border-cyan-500/40 hover:border-cyan-400',
    badgeColor: 'text-cyan-300 bg-cyan-500/15 border-cyan-400/30',
    title: t('nav.arena'),
    desc: t('pages.arenaDesc'),
    statusId: 'dash-crosshair-code',
    previewId: 'dash-crosshair-preview',
  },
  {
    key: 'viewmodel' as const,
    icon: '🔫',
    accent: 'border-amber-500/40 hover:border-amber-400',
    badgeColor: 'text-amber-300 bg-amber-500/15 border-amber-400/30',
    title: t('nav.viewmodel'),
    desc: t('pages.viewmodelDesc'),
    statusId: 'dash-viewmodel-summary',
  },
  {
    key: 'buy-binds' as const,
    icon: '⌨️',
    accent: 'border-emerald-500/40 hover:border-emerald-400',
    badgeColor: 'text-emerald-300 bg-emerald-500/15 border-emerald-400/30',
    title: t('nav.buyBinds'),
    desc: t('pages.buyBindsDesc'),
    statusId: 'dash-binds-count',
  },
  {
    key: 'autoexec' as const,
    icon: '📦',
    accent: 'border-purple-500/40 hover:border-purple-400',
    badgeColor: 'text-purple-300 bg-purple-500/15 border-purple-400/30',
    title: t('nav.autoexec'),
    desc: t('pages.autoexecDesc'),
    statusId: null,
  },
];
---

<section class="text-center max-w-4xl mx-auto mb-12 space-y-5">
  <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-400/30 text-cyan-300 text-xs font-semibold">
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
    <span>{t('hero.badge')}</span>
  </div>

  <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
    {t('hero.title')}
  </h1>

  <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
    {t('hero.subtitle')}
  </p>

  <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
    <a
      href={getLocalizedPath(lang, 'spray-arena', isPrefixed)}
      class="px-6 py-3 rounded-xl font-bold text-sm bg-gradient-to-r from-cyan-500 to-sky-500 hover:from-cyan-400 hover:to-sky-400 text-slate-950 shadow-[0_0_24px_rgba(34,211,238,0.35)] transition-all hover:scale-[1.02]"
    >
      {t('nav.arena')} →
    </a>
    <a
      href={getLocalizedPath(lang, 'autoexec', isPrefixed)}
      class="px-6 py-3 rounded-xl font-bold text-sm bg-slate-900/90 hover:bg-slate-800 border border-slate-700 hover:border-amber-400/60 text-white transition-all"
    >
      {t('autoexec.downloadCfg')}
    </a>
  </div>
</section>

<section class="mb-10">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-5">
    <h2 class="text-lg font-bold text-white">{t('home.featuresTitle')}</h2>
    <span class="text-xs font-mono text-emerald-300 bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-1 rounded-md">
      {t('home.syncedBadge')}
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {cards.map((card) => (
      <a
        href={getLocalizedPath(lang, card.key, isPrefixed)}
        class={`cs2-glass rounded-2xl p-6 border ${card.accent} transition-all group flex flex-col justify-between gap-4 hover:-translate-y-0.5`}
      >
        <div class="space-y-3">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="text-2xl" aria-hidden="true">{card.icon}</span>
              <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors">{card.title}</h3>
            </div>
            {card.previewId && (
              <div id={card.previewId} class="w-11 h-11 rounded-lg bg-slate-950/90 border border-slate-700/70 flex items-center justify-center shrink-0"></div>
            )}
          </div>
          <p class="text-sm text-slate-400 leading-relaxed">{card.desc}</p>
        </div>

        <div class="flex items-center justify-between gap-2 pt-3 border-t border-slate-800/80">
          {card.statusId ? (
            <span id={card.statusId} class={`text-[11px] font-mono px-2.5 py-1 rounded-md border truncate max-w-[230px] ${card.badgeColor}`}>
              Synced
            </span>
          ) : (
            <span class="text-[11px] font-mono text-slate-400">autoexec.cfg</span>
          )}
          <span class="text-xs font-bold text-cyan-300 group-hover:translate-x-0.5 transition-transform">
            {t('home.openModule')} →
          </span>
        </div>
      </a>
    ))}
  </div>
</section>

<script>
  import { mountHomeDashboard } from '../scripts/homeDashboard.js';
  mountHomeDashboard();
</script>
