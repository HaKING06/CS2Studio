---
import { getDictionary, getLocalizedPath, translateKey } from '../utils/i18n.js';

interface Props {
  lang: string;
  isPrefixed: boolean;
}

const { lang, isPrefixed } = Astro.props;
const dict = getDictionary(lang);
const t = (key: string) => translateKey(dict, key);
---

<section id="autoexec-section" class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">{t('autoexec.title')}</h1>
      <p class="text-sm text-slate-400 mt-1">{t('autoexec.subtitle')}</p>
    </div>

    <div class="flex flex-wrap items-center gap-2.5">
      <button id="btn-reset-studio" type="button" class="px-3.5 py-2 rounded-xl border border-rose-500/40 bg-rose-950/40 hover:bg-rose-900/50 text-xs font-semibold text-rose-300 cursor-pointer">
        {t('autoexec.resetAll')}
      </button>
      <button id="btn-copy-autoexec" type="button" class="px-4 py-2 rounded-xl border border-slate-600 bg-slate-800 hover:bg-slate-700 text-xs font-bold text-white cursor-pointer">
        📋 {t('autoexec.copyCfg')}
      </button>
      <button id="btn-download-autoexec" type="button" class="px-5 py-2 rounded-xl bg-gradient-to-r from-cyan-500 to-sky-500 hover:from-cyan-400 hover:to-sky-400 text-slate-950 text-xs font-extrabold shadow-[0_0_25px_rgba(34,211,238,0.35)] cursor-pointer">
        ⬇ {t('autoexec.downloadCfg')}
      </button>
    </div>
  </div>

  <!-- Synced Config Strip from other pages -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
    <a href={getLocalizedPath(lang, 'spray-arena', isPrefixed)} class="cs2-glass rounded-xl p-3.5 flex items-center justify-between gap-2 hover:border-cyan-400/50 transition-colors">
      <span class="text-slate-400">{t('nav.arena')}:</span>
      <span id="summary-crosshair-code" class="font-mono text-cyan-300 truncate max-w-[180px]">—</span>
    </a>
    <a href={getLocalizedPath(lang, 'viewmodel', isPrefixed)} class="cs2-glass rounded-xl p-3.5 flex items-center justify-between gap-2 hover:border-amber-400/50 transition-colors">
      <span class="text-slate-400">{t('nav.viewmodel')}:</span>
      <span id="summary-viewmodel-fov" class="font-mono text-amber-300 truncate max-w-[190px]">—</span>
    </a>
    <a href={getLocalizedPath(lang, 'buy-binds', isPrefixed)} class="cs2-glass rounded-xl p-3.5 flex items-center justify-between gap-2 hover:border-emerald-400/50 transition-colors">
      <span class="text-slate-400">{t('buyBinds.bindCount')}:</span>
      <span id="summary-buy-count" class="font-mono font-bold text-emerald-300">0</span>
    </a>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
    <div class="xl:col-span-5 cs2-glass rounded-2xl p-5 space-y-4">
      <h2 class="text-sm font-bold uppercase tracking-wider text-cyan-300">{t('autoexec.optimizations')}</h2>

      <div class="grid grid-cols-3 gap-3">
        <div>
          <label for="cfg-sensitivity" class="block text-[11px] text-slate-400 mb-1">{t('autoexec.sensitivity')}</label>
          <input id="cfg-sensitivity" type="number" step="0.05" min="0.1" max="10" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs font-mono text-white focus:border-cyan-400 focus:outline-none" />
        </div>
        <div>
          <label for="cfg-zoom-sens" class="block text-[11px] text-slate-400 mb-1">{t('autoexec.zoomSensitivity')}</label>
          <input id="cfg-zoom-sens" type="number" step="0.05" min="0.1" max="2" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs font-mono text-white focus:border-cyan-400 focus:outline-none" />
        </div>
        <div>
          <label for="cfg-fps-max" class="block text-[11px] text-slate-400 mb-1">{t('autoexec.fpsMax')}</label>
          <input id="cfg-fps-max" type="number" step="10" min="0" max="1000" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs font-mono text-white focus:border-cyan-400 focus:outline-none" />
        </div>
      </div>

      <div class="space-y-2 pt-2">
        <label class="flex items-center justify-between p-2.5 rounded-xl bg-slate-900/60 border border-slate-800 text-xs text-slate-200 cursor-pointer">
          <span>{t('autoexec.optLowLatency')}</span>
          <input id="opt-low-latency" type="checkbox" class="accent-cyan-400 cursor-pointer" />
        </label>
        <label class="flex items-center justify-between p-2.5 rounded-xl bg-slate-900/60 border border-slate-800 text-xs text-slate-200 cursor-pointer">
          <span>{t('autoexec.optHudTelemetry')}</span>
          <input id="opt-hud-telemetry" type="checkbox" class="accent-cyan-400 cursor-pointer" />
        </label>
        <label class="flex items-center justify-between p-2.5 rounded-xl bg-slate-900/60 border border-slate-800 text-xs text-slate-200 cursor-pointer">
          <span>{t('autoexec.optAudio')}</span>
          <input id="opt-comp-audio" type="checkbox" class="accent-cyan-400 cursor-pointer" />
        </label>
        <label class="flex items-center justify-between p-2.5 rounded-xl bg-slate-900/60 border border-slate-800 text-xs text-slate-200 cursor-pointer">
          <span>{t('autoexec.optRadar')}</span>
          <input id="opt-tactical-radar" type="checkbox" class="accent-cyan-400 cursor-pointer" />
        </label>
        <label class="flex items-center justify-between p-2.5 rounded-xl bg-slate-900/60 border border-slate-800 text-xs text-slate-200 cursor-pointer">
          <span>{t('autoexec.optMouse')}</span>
          <input id="opt-clean-mouse" type="checkbox" class="accent-cyan-400 cursor-pointer" />
        </label>
        <label class="flex items-center justify-between p-2.5 rounded-xl bg-slate-900/60 border border-slate-800 text-xs text-slate-200 cursor-pointer">
          <span>{t('autoexec.optJumpThrow')}</span>
          <input id="opt-jump-helpers" type="checkbox" class="accent-amber-400 cursor-pointer" />
        </label>
      </div>

      <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-400/30 space-y-1.5">
        <div class="text-xs font-bold text-amber-300">{t('autoexec.installPathTitle')}</div>
        <div class="text-[11px] font-mono text-slate-300 break-all">{t('autoexec.installPath')}</div>
        <div class="text-[11px] font-mono text-cyan-300">{t('autoexec.launchOption')}</div>
      </div>
    </div>

    <div class="xl:col-span-7 cs2-glass rounded-2xl p-5 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono font-bold text-slate-300">autoexec.cfg</span>
        <span class="text-[11px] font-mono text-emerald-400">Live LocalStorage Sync</span>
      </div>
      <pre id="autoexec-output" dir="ltr" class="p-4 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-cyan-100 h-[440px] overflow-auto whitespace-pre leading-relaxed text-left"></pre>
    </div>
  </div>
</section>

<script>
  import { mountAutoexecPage } from '../scripts/autoexecStudio.js';
  mountAutoexecPage();
</script>
